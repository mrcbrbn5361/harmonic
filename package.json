{
  "name": "harmonic-desktop",
  "version": "1.0.3",
  "description": "Harmonic - Premium music streaming experience for your desktop",
  "private": true,
  "workspaces": [
    "desktop",
    "website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=desktop",
    "typecheck": "npm run typecheck --workspace=desktop",
    "build": "npm run build --workspace=desktop",
    "build:website": "npm run build --workspace=website",
    "build:all": "npm run build --workspace=desktop && npm run build:website",
    "build:installer": "npm run build:installer --workspace=desktop",
    "build:win": "npm run build:win --workspace=desktop",
    "build:mac": "npm run build:mac --workspace=desktop"
  },
  "author": "Harmonic Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrcbrbn5361/harmonic"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  }
}
